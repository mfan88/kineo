# Kineō server settings. infra/setup.sh copies this to infra/kineo.env (git-ignored,
# chmod 600) and fills in every secret for you; you only need to set the values
# marked "You set".
#
# Never commit infra/kineo.env or paste its values anywhere.

# ─── Public addresses ──────────────────────────────────────────────────────
# You set. Where the apps reach the API (REST + Storage) and PowerSync, via the
# host Caddy. No trailing slash.
API_PUBLIC_URL=
SYNC_PUBLIC_URL=

# ─── Data ──────────────────────────────────────────────────────────────────
# You set. Folder for all Kineō data (database and uploaded files), e.g. on the
# SSD: /mnt/nvme/kineo. setup.sh creates db/, db-config/ and storage/ in it and
# refuses to put them on the system disk (a sign the SSD isn't mounted).
KINEO_DATA_DIR=

# ─── Clerk ─────────────────────────────────────────────────────────────────
# You set. Your Clerk Frontend API domain, without https:// (Clerk dashboard →
# Configure → Domains, or https://clerk.com/setup/supabase), e.g.
# clerk.getkineo.work or your-app.clerk.accounts.dev. setup.sh fetches its public
# keys from https://<CLERK_DOMAIN>/.well-known/jwks.json.
CLERK_DOMAIN=

# ─── Database ──────────────────────────────────────────────────────────────
# Generated. Password for postgres and the service roles (authenticator,
# supabase_storage_admin). Letters and digits only, so it's safe in URLs.
POSTGRES_PASSWORD=

# ─── Tokens ────────────────────────────────────────────────────────────────
# Generated. The stack's own HS256 signing secret (at least 32 characters). Signs
# ANON_KEY and SERVICE_ROLE_KEY below; Clerk signs users' tokens with its own keys.
JWT_SECRET=
# Generated. Long-lived HS256 tokens for the anon and service_role roles, signed
# with JWT_SECRET. SERVICE_ROLE_KEY bypasses row-level security: it stays on this
# server and is never put in an app.
ANON_KEY=
SERVICE_ROLE_KEY=
# Generated. Clerk's public keys plus JWT_SECRET as one JSON Web Key Set, on one
# line. PostgREST and Storage use it to check every request's token. setup.sh
# rebuilds it when Clerk rotates keys.
JWT_JWKS=
# Seconds a token the stack issues stays valid. Default 3600.
JWT_EXPIRY=3600

# ─── PowerSync ─────────────────────────────────────────────────────────────
# Generated. Passwords for PowerSync's read-only replication role and its storage
# database user. Letters and digits only.
POWERSYNC_DB_PASSWORD=
POWERSYNC_STORAGE_PASSWORD=
# You set. The `aud` claim PowerSync requires in users' tokens. Use the same value
# in the Clerk JWT template the apps use for PowerSync, e.g. getkineo-sync.
POWERSYNC_JWT_AUDIENCE=

# ─── Studio (admin dashboard, local only) ──────────────────────────────────
# Generated. Encrypts connection details between Studio and postgres-meta (at
# least 32 characters).
PG_META_CRYPTO_KEY=

# ─── Backups ───────────────────────────────────────────────────────────────
# You set. The age PUBLIC key (age1…) backups are encrypted to. Make the key pair
# on your own computer, not the server: age-keygen -o kineo-backup.key
# then paste the "public key" line here. Keep kineo-backup.key safe and off the
# server: it's the only way to read the backups.
BACKUP_AGE_RECIPIENT=
# You set. Folder for the encrypted backups, e.g. the external drive's mount point.
BACKUP_DIR=
# How many nightly backups to keep. Default 14.
BACKUP_KEEP=14

# ─── Local ports (127.0.0.1 only) ──────────────────────────────────────────
# Change only if one is already taken on this machine. The Caddy snippet uses
# the REST, Storage and PowerSync ports.
KINEO_REST_PORT=55321
KINEO_STORAGE_PORT=55322
KINEO_STUDIO_PORT=55323
KINEO_DB_PORT=55324
KINEO_SYNC_PORT=55325
