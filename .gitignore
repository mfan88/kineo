# ─── Dependencies ───────────────────────────────
node_modules/
.pnpm-store/

# ─── Secrets and environment ────────────────────
# Never commit real keys. Only .env.example files (blank values) are tracked.
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
*.keystore
*.jks
*.mobileprovision
google-services.json
GoogleService-Info.plist

# ─── Build output and caches ────────────────────
dist/
build/
out/
coverage/
.turbo/
.cache/
*.tsbuildinfo
.eslintcache
.vite/

# ─── Expo / React Native (apps/mobile) ──────────
.expo/
expo-env.d.ts
web-build/
# Native folders are generated by `expo prebuild`; remove these two lines
# if you ever start committing custom native code.
apps/mobile/ios/
apps/mobile/android/
*.apk
*.aab
*.ipa
.metro-health-check*

# ─── Tauri / Rust (apps/desktop) ────────────────
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/schemas/
*.dmg
*.msi
*.exe

# ─── Supabase (local dev) ───────────────────────
supabase/.branches/
supabase/.temp/
supabase/.env

# ─── Server / infra ─────────────────────────────
infra/.env
# Server secrets written by infra/setup.sh (the template is infra/kineo.env.example).
infra/kineo.env
infra/**/data/
infra/**/volumes/
infra/backup/*.sql
infra/backup/*.sql.gz
infra/backup/*.dump
infra/backup/*.age
infra/backup/*.gpg

# Database dumps and local SQLite files anywhere (may contain patient data)
*.sql.gz
*.dump
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# ─── Logs ───────────────────────────────────────
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Claude Code (personal, not shared) ─────────
.claude/settings.local.json

# ─── OS and editors ─────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo