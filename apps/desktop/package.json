{
  "name": "@kineo/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "build:app": "tauri build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.scripts.json",
    "lint": "oxlint --type-aware",
    "test": "vitest run",
    "icon": "node scripts/app-icon.ts && tauri icon src-tauri/icons/app-icon.png && rm -rf src-tauri/icons/android src-tauri/icons/ios"
  },
  "dependencies": {
    "@clerk/clerk-js": "6.42.3",
    "@clerk/react": "6.18.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@gravity-ui/icons": "^2.23.1",
    "@heroui/react": "^3.2.7",
    "@heroui/styles": "^3.2.7",
    "@kineo/data": "workspace:*",
    "@kineo/invoice-template": "workspace:*",
    "@kineo/shared": "workspace:*",
    "@kineo/tokens": "workspace:*",
    "@powersync/tauri-plugin": "0.0.6",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@kineo/config": "workspace:*",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.0.16",
    "vitest": "^5.1.0"
  }
}
