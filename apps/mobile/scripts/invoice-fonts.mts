/**
 * Writes the invoice fonts into src/invoice/fonts.generated.ts as base64, so the
 * invoice preview and PDF can embed them (iOS printing can't load local font files).
 * The files are the same Fontsource woff2 files desktop uses. Run with
 * `pnpm --filter @kineo/mobile invoice-fonts` after upgrading Fontsource; the
 * output is committed.
 */
import { readFileSync, writeFileSync } from "node:fs";
import { createRequire } from "node:module";

const require = createRequire(import.meta.url);

const FILES = {
  interLatin: "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2",
  interLatinExt: "@fontsource-variable/inter/files/inter-latin-ext-wght-normal.woff2",
  nunitoLatin: "@fontsource-variable/nunito/files/nunito-latin-wght-normal.woff2",
  nunitoLatinExt: "@fontsource-variable/nunito/files/nunito-latin-ext-wght-normal.woff2",
};

const entries = Object.entries(FILES).map(([name, file]) => {
  const base64 = readFileSync(require.resolve(file)).toString("base64");
  return `  ${name}: "data:font/woff2;base64,${base64}",`;
});

const output = `// Generated by scripts/invoice-fonts.mts from Fontsource's woff2 files. Don't edit.
import type { InvoiceFontSources } from "@kineo/invoice-template";

export const INVOICE_FONT_SOURCES: InvoiceFontSources = {
${entries.join("\n")}
};
`;

writeFileSync(new URL("../src/invoice/fonts.generated.ts", import.meta.url), output);
