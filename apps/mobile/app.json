{
  "expo": {
    "name": "Kineō",
    "slug": "kineo",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "tech.fenna.kineo",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E0F2FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "tech.fenna.kineo"
    },
    "scheme": "kineo",
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E0F2FE",
          "image": "./assets/splash.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "android": {
            "image": "./assets/splash-android.png",
            "imageWidth": 240
          }
        }
      ],
      "@clerk/expo",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "cca696db-eeb0-4f7c-bda5-0f81e37b77b2"
      }
    },
    "owner": "marcuscmfan2"
  }
}
